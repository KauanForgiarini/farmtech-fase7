# Copie para .env (o .env NÃO vai para o GitHub) e ajuste se necessário.

# Banco de dados da Fase 3: sqlite (padrão, sem rede) ou oracle (FIAP)
FARMTECH_DB=sqlite
# ORACLE_USER=RM574005
# ORACLE_PASSWORD=sua_senha
# ORACLE_HOST=oracle.fiap.com.br
# ORACLE_PORT=1521
# ORACLE_SID=ORCL

# AWS: as credenciais do Learner Lab ficam em ~/.aws/credentials (AWS Details > AWS CLI).
# Variáveis abaixo são opcionais; o deploy_aws.py grava os nomes em data/aws_config.json.
AWS_DEFAULT_REGION=us-east-1
# FARMTECH_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<conta>:farmtech-alertas
# FARMTECH_S3_BUCKET=farmtech-alertas-<conta>-us-east-1
# FARMTECH_LAMBDA=farmtech-alertas
